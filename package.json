{
  "name": "swiggy-cli",
  "version": "0.3.1",
  "description": "Swiggy from your terminal, for people and for agents: Food, Instamart, Dineout and Scenes. A direct client for Swiggy's public API with UPI payments, a stable JSON envelope, and bundled agent skills.",
  "type": "module",
  "license": "MIT",
  "author": "Harshit Khemani <harshitkhemani@gmail.com> (https://github.com/HKTITAN)",
  "homepage": "https://github.com/HKTITAN/swiggy-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HKTITAN/swiggy-cli.git"
  },
  "bugs": {
    "url": "https://github.com/HKTITAN/swiggy-cli/issues"
  },
  "keywords": [
    "swiggy",
    "mcp",
    "cli",
    "food",
    "instamart",
    "dineout",
    "tickets",
    "events",
    "scenes",
    "upi",
    "payments",
    "agent",
    "ai",
    "anthropic",
    "claude",
    "skills",
    "skills.sh",
    "agent-plugins",
    "model-context-protocol"
  ],
  "bin": {
    "swiggy": "dist/cli.js",
    "smn": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "wiki",
    "skills",
    "skills.sh.json",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".claude-plugin",
    "LICENSE",
    "assets/swiggy-logo.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:skills": "node scripts/validate-skills.mjs",
    "prepublishOnly": "npm run lint && npm run build",
    "pack:check": "npm pack --dry-run",
    "gen:tools": "node scripts/gen-tools-reference.mjs",
    "check:tools": "node scripts/gen-tools-reference.mjs --check"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
